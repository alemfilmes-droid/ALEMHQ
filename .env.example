# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Somente servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública do app (sem barra final). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push (notificações no celular). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@alemfilmes.com.br
